---
import { getCollection, getEntries, getEntry, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GrammarCard from '../../../components/GrammarCard.astro';
import { levelSlug } from '../../../lib/levels';
import { grammarSlug, grammarUrl, highlightParts, type GrammarEntry } from '../../../lib/grammar';

// One page per grammar point, e.g. /m1/grammar/bol/.
export async function getStaticPaths() {
  const entries = await getCollection('grammar', (entry) => !entry.data.draft);
  return entries.map((entry) => ({
    params: { level: levelSlug(entry.data.level), slug: grammarSlug(entry) },
    props: { entry },
  }));
}

interface Props {
  entry: GrammarEntry;
}

const { entry } = Astro.props;
const { title, subtitle, level, examples, related } = entry.data;
const relatedEntries = (await getEntries(related)).filter((other) => !other.data.draft);
const explanation = await getEntry('explanations', `en/${entry.id}`);
const { Content } = explanation ? await render(explanation) : { Content: null };
---

<BaseLayout title={subtitle ? `${title} · ${subtitle}` : title}>
  <GrammarCard entry={entry} />

  <article class="prose">
    {Content && <Content />}

    {examples.length > 0 && (
      <section>
        <h2>Example sentences</h2>
        <ol class="examples">
          {examples.map((example) => (
            <li>
              <p lang="mn" class="mn">
                {highlightParts(example.mn, title).map((part) =>
                  part.hit ? <mark>{part.text}</mark> : part.text,
                )}
              </p>
              <p>{example.en}</p>
            </li>
          ))}
        </ol>
      </section>
    )}

    {relatedEntries.length > 0 && (
      <section>
        <h2>Бусад түвшинд</h2>
        <ul>
          {relatedEntries.map((other) => (
            <li>
              <a href={grammarUrl(other)}>
                {other.data.level} · {other.data.title}
              </a>{' '}
              — {other.data.meaning}
            </li>
          ))}
        </ul>
      </section>
    )}

    <p class="back">
      ← <a href={`/${levelSlug(level)}/grammar/`}>{level} Grammar List</a>
    </p>
  </article>
</BaseLayout>

<style>
  .prose {
    margin-bottom: 3rem;
    line-height: 1.7;
  }

  .prose :global(h2) {
    display: inline-block;
    margin: 1.5rem 0 0.5rem;
    padding-bottom: 0.2rem;
    border-bottom: 3px solid var(--flag-red);
    font-size: 1.5rem;
  }

  .prose :global(table) {
    border-collapse: collapse;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--color-border);
    text-align: left;
  }

  .examples {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-left: 1.5rem;
  }

  .examples p {
    margin: 0;
  }

  .mn {
    font-size: 1.15rem;
    font-weight: 700;
  }

  mark {
    background: none;
    color: var(--flag-red);
    font-weight: 900;
  }

  .back {
    margin-top: 2.5rem;
  }
</style>
