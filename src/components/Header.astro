---
import { LEVELS, levelSlug } from '../lib/levels';
import { LOCALES, localePath, splitLocale, type Locale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';
import LogoMark from './LogoMark.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// Locale-free path of the current page, e.g. /ru/m3/grammar/ -> /m3/grammar/.
const { path } = splitLocale(Astro.url.pathname);
// Highlight the level whose section is currently open, e.g. /m3/grammar/ -> M3.
const currentSegment = path.split('/')[1];
---

<header class="site-header">
  <div class="container header-inner">
    <a href={localePath(locale, '/')} class="logo">
      <LogoMark size={40} />
      Tuulai
    </a>
    <nav class="levels-nav" aria-label={t('nav.levels')}>
      <ul class="levels">
        {LEVELS.map((level) => (
          <li>
            <details class="level-menu">
              <summary class:list={{ active: currentSegment === levelSlug(level) }}>
                {level}
              </summary>
              <div class="dropdown">
                <a href={localePath(locale, `/${levelSlug(level)}/grammar/`)}>
                  {t('nav.grammarList')}
                </a>
              </div>
            </details>
          </li>
        ))}
      </ul>
    </nav>
    <nav class="lang-nav" aria-label={t('nav.language')}>
      <ul class="langs">
        {LOCALES.map((l) => (
          <li>
            <a
              href={localePath(l, path)}
              hreflang={l}
              lang={l}
              aria-current={l === locale ? 'true' : undefined}
            >
              {l.toUpperCase()}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  // Keep only one level menu open, and close it when clicking outside.
  const menus = [...document.querySelectorAll<HTMLDetailsElement>('.level-menu')];
  menus.forEach((menu) =>
    menu.addEventListener('toggle', () => {
      if (menu.open) menus.forEach((other) => other !== menu && (other.open = false));
    }),
  );
  document.addEventListener('click', (event) => {
    if (!(event.target as Element).closest('.level-menu')) {
      menus.forEach((menu) => (menu.open = false));
    }
  });
</script>

<style>
  .site-header {
    background: var(--color-bg);
    border-bottom: 6px solid var(--flag-red);
  }

  .header-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'logo levels langs';
    align-items: stretch;
    column-gap: 1.5rem;
  }

  .logo {
    grid-area: logo;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--flag-blue);
    text-decoration: none;
  }

  .levels-nav {
    grid-area: levels;
  }

  .lang-nav {
    grid-area: langs;
    display: flex;
    align-items: center;
  }

  .levels,
  .langs {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .levels {
    flex-wrap: wrap;
    height: 100%;
  }

  .level-menu {
    position: relative;
    height: 100%;
  }

  summary {
    display: flex;
    align-items: center;
    height: 100%;
    padding: 1.25rem 1.1rem;
    font-size: 1.1rem;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover,
  .level-menu[open] > summary,
  summary.active {
    background: var(--flag-blue);
    color: #fff;
  }

  .dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 10;
    min-width: 11rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--flag-gold);
    box-shadow: 0 6px 16px rgb(0 0 0 / 0.12);
  }

  .dropdown a {
    display: block;
    padding: 0.75rem 1rem;
    color: var(--color-text);
    text-decoration: none;
  }

  .dropdown a:hover {
    background: var(--color-surface);
    color: var(--flag-red);
  }

  .langs {
    gap: 0.25rem;
  }

  .langs a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    border-radius: 6px;
    color: var(--color-muted);
    font-weight: 700;
    text-decoration: none;
  }

  .langs a:hover {
    color: var(--flag-red);
  }

  .langs a[aria-current='true'] {
    color: var(--flag-blue);
    box-shadow: inset 0 -3px 0 var(--flag-gold);
  }

  /* Phones: logo and languages share the top row, the six levels fill the row below. */
  @media (max-width: 640px) {
    .header-inner {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'logo langs'
        'levels levels';
      padding-inline: 0;
    }

    .logo {
      padding: 0.6rem 1rem;
      font-size: 1.5rem;
    }

    .lang-nav {
      padding-right: 0.5rem;
    }

    .levels-nav {
      position: relative;
    }

    .levels {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    /* Anchor dropdowns to the nav so they never overflow the screen edge. */
    .level-menu {
      position: static;
    }

    summary {
      justify-content: center;
      min-height: 2.75rem;
      padding: 0.75rem 0;
      font-size: 1rem;
    }

    .dropdown {
      right: 0;
      min-width: 0;
    }

    .dropdown a {
      padding: 0.9rem 1rem;
      text-align: center;
    }
  }
</style>
