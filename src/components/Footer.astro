---
// Site footer: link to the About page.
import { localePath, type Locale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<footer class="site-footer">
  <div class="container footer-inner">
    <span>Tuulai</span>
    <a href={localePath(locale, '/about/')}>{t('footer.about')}</a>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 3.5rem;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-muted);
  }

  a:hover {
    color: var(--flag-red);
  }
</style>
