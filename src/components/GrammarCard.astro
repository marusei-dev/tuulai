---
// Summary card shown at the top of every grammar page ("A · Цагаан" design):
// title, subtitle, meaning, usage and the first two example sentences, with the
// meaning and translations in the reader's language.
import LogoMark from './LogoMark.astro';
import { highlightParts, type GrammarEntry } from '../lib/grammar';
import type { Locale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';
// Shared with the admin preview, so editors see the card exactly as the site shows it.
import '../styles/grammar-card.css';

interface Props {
  entry: GrammarEntry;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const { title, subtitle, meaning, level, script, usage, examples } = entry.data;
const t = useTranslations(locale);

const highlight = (text: string) => highlightParts(text, title);
---

<section class="grammar-card" aria-labelledby="grammar-title">
  <div class="card">
    {script && (
      <div class="watermark" lang="mn-Mong" aria-hidden="true">
        {script}
      </div>
    )}

    <div class="top">
      <div class="brand">
        <LogoMark size={48} />
        <div>
          <div class="brand-sub">{t('card.learnAt')}</div>
          <div class="brand-name">tuulai.pages.dev</div>
        </div>
      </div>
      <div class="badge">{level} · ДҮРЭМ</div>
    </div>

    <div class="heading">
      <h1 id="grammar-title" lang="mn">
        {title}
      </h1>
      {subtitle && (
        <p class="subtitle" lang="mn">
          {subtitle}
        </p>
      )}
    </div>

    <div class="body">
      <dl class="facts">
        <div class="fact">
          <dt>Утга</dt>
          <dd>{meaning[locale]}</dd>
        </div>
        {usage.length > 0 && (
          <div class="fact">
            <dt>Хэрэглээ</dt>
            <dd lang="mn">
              {usage.map((line) => (
                <div>
                  {highlight(line).map((part) => (part.hit ? <mark>{part.text}</mark> : part.text))}
                </div>
              ))}
            </dd>
          </div>
        )}
      </dl>

      {examples.length > 0 && (
        <ul class="examples">
          {examples.slice(0, 2).map((example) => (
            <li>
              <p class="mn" lang="mn">
                {highlight(example.mn).map((part) =>
                  part.hit ? <mark>{part.text}</mark> : part.text,
                )}
              </p>
              <p class="translation">{example[locale]}</p>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</section>
