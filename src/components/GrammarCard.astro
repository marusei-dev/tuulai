---
// Summary card shown at the top of every grammar page ("A · Цагаан" design):
// title, romanization, meaning, usage and the first two example sentences.
import LogoMark from './LogoMark.astro';
import type { GrammarEntry } from '../lib/grammar';

interface Props {
  entry: GrammarEntry;
}

const { title, romanization, meaning, level, script, usage, examples } = Astro.props.entry.data;

// Split text around the grammar point so it can be highlighted, e.g.
// "Би бол оюутан." -> [{ text: "Би " }, { text: "бол", hit: true }, { text: " оюутан." }].
const escaped = title.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const highlight = (text: string) =>
  text
    .split(new RegExp(`(${escaped})`, 'g'))
    .filter(Boolean)
    .map((part) => ({ text: part, hit: part === title }));
---

<section class="card-wrap" aria-labelledby="grammar-title">
  <div class="card">
    {script && (
      <div class="watermark" lang="mn-Mong" aria-hidden="true">
        {script}
      </div>
    )}

    <div class="top">
      <div class="brand">
        <LogoMark size={48} />
        <div>
          <div class="brand-sub">Learn Mongolian at</div>
          <div class="brand-name">tuulai.pages.dev</div>
        </div>
      </div>
      <div class="badge">{level} · ДҮРЭМ</div>
    </div>

    <div class="heading">
      <h1 id="grammar-title" lang="mn">
        {title}
      </h1>
      <p class="romanization">{romanization}</p>
    </div>

    <div class="body">
      <dl class="facts">
        <div class="fact">
          <dt>Утга</dt>
          <dd>{meaning}</dd>
        </div>
        {usage.length > 0 && (
          <div class="fact">
            <dt>Хэрэглээ</dt>
            <dd lang="mn">
              {usage.map((line) => (
                <div>
                  {highlight(line).map((part) => (part.hit ? <mark>{part.text}</mark> : part.text))}
                </div>
              ))}
            </dd>
          </div>
        )}
      </dl>

      {examples.length > 0 && (
        <ul class="examples">
          {examples.slice(0, 2).map((example) => (
            <li>
              <p class="mn" lang="mn">
                {highlight(example.mn).map((part) =>
                  part.hit ? <mark>{part.text}</mark> : part.text,
                )}
              </p>
              <p class="latin">{example.latin}</p>
              <p class="en">{example.en}</p>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</section>

<style>
  /* Sizes are in cqi (1% of the card width) so the card scales like an image;
     clamp() keeps text readable on phones, where the columns also stack. */
  .card-wrap {
    container-type: inline-size;
    margin-block: clamp(1rem, 4vw, 2rem) 2rem;
  }

  .card {
    position: relative;
    overflow: hidden;
    padding: 0 5.3cqi 4.7cqi;
    background: #faf8f3;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    font-family: Nunito, system-ui, sans-serif;
    color: var(--color-text);
  }

  .card > :not(.watermark) {
    position: relative;
  }

  .watermark {
    position: absolute;
    top: -2.5cqi;
    right: 5.8cqi;
    writing-mode: vertical-lr;
    font-family: 'Noto Sans Mongolian', serif;
    font-size: 46cqi;
    line-height: 1;
    color: var(--flag-blue);
    opacity: 0.06;
    pointer-events: none;
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-top: clamp(0.75rem, 2.3cqi, 1.75rem);
  }

  .brand-sub {
    font-size: clamp(0.7rem, 1.2cqi, 0.875rem);
    font-weight: 600;
    color: var(--color-muted);
  }

  .brand-name {
    font-size: clamp(0.9rem, 1.7cqi, 1.25rem);
    font-weight: 900;
  }

  .badge {
    padding: clamp(0.4rem, 0.8cqi, 0.625rem) clamp(0.75rem, 1.8cqi, 1.375rem);
    background: var(--flag-blue);
    color: #fff;
    font-size: clamp(0.85rem, 1.8cqi, 1.375rem);
    font-weight: 900;
    letter-spacing: 1px;
    white-space: nowrap;
    border-radius: 0 0 8px 8px;
  }

  .heading {
    margin-block: 3cqi 3.7cqi;
    text-align: center;
  }

  h1 {
    margin: 0;
    font-size: clamp(3.5rem, 11.7cqi, 8.75rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--flag-blue);
  }

  .romanization {
    margin: 0.25rem 0 0;
    font-size: clamp(1.5rem, 3.3cqi, 2.5rem);
    font-weight: 800;
    color: var(--flag-red);
  }

  .body {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4cqi;
  }

  .facts {
    display: flex;
    flex-direction: column;
    gap: 1.8cqi;
    margin: 0;
  }

  .fact {
    display: flex;
    gap: 1.25rem;
    align-items: baseline;
  }

  dt {
    flex-shrink: 0;
    width: clamp(6rem, 12.5cqi, 9.4rem);
    padding: 0.35rem 0.75rem;
    box-sizing: border-box;
    background: var(--color-text);
    color: #fff;
    font-size: clamp(0.85rem, 1.4cqi, 1.05rem);
    font-weight: 800;
    border-radius: 4px;
  }

  dd {
    margin: 0;
    font-size: clamp(1rem, 1.8cqi, 1.375rem);
    font-weight: 500;
  }

  mark {
    background: none;
    color: var(--flag-red);
    font-weight: 900;
  }

  .examples {
    display: flex;
    flex-direction: column;
    gap: 1.8cqi;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .examples p {
    margin: 0;
  }

  .mn {
    font-size: clamp(1.15rem, 2cqi, 1.5rem);
    font-weight: 700;
  }

  .latin,
  .en {
    font-size: clamp(0.9rem, 1.4cqi, 1.05rem);
    color: #4b545e;
  }

  .latin {
    font-style: italic;
  }

  @container (max-width: 640px) {
    .body {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }

    .facts,
    .examples {
      gap: 1rem;
    }

    .heading {
      margin-block: 1.5rem;
    }
  }
</style>
