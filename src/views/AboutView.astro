---
// About page: what Tuulai is, what inspired it, and the sources behind the grammar content.
import BaseLayout from '../layouts/BaseLayout.astro';
import LogoMark from '../components/LogoMark.astro';
import type { Locale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout title={t('about.title')} locale={locale}>
  <article class="about">
    {locale === 'ru' ? (
      <>
        <header>
          <LogoMark size={64} />
          <h1>О проекте Tuulai</h1>
        </header>

        <p class="lead">
          Tuulai (<span lang="mn">туулай</span>, «заяц») — бесплатный сайт для пошагового изучения
          грамматики монгольского языка, от уровня M1 до M6.
        </p>

        <section>
          <h2>Вдохновение</h2>
          <p>
            Идея и структура Tuulai — списки грамматики по уровням и карточка в начале каждой темы —
            вдохновлены сайтом{' '}
            <a href="https://jlptsensei.com/" rel="noopener">
              JLPT Sensei
            </a>{' '}
            для изучения японского языка. Tuulai — независимый проект и не связан с JLPT Sensei.
          </p>
        </section>

        <section>
          <h2>Источники</h2>
          <p>Объяснения грамматики на этом сайте основаны на книге:</p>
          <ul>
            <li>
              Rita Kullmann, D. Tserenpil. <cite>Mongolian Grammar</cite>.
            </li>
          </ul>
          <p>
            Объяснения и примеры на Tuulai написаны нашими словами и упрощены для каждого уровня.
          </p>
        </section>
      </>
    ) : (
      <>
        <header>
          <LogoMark size={64} />
          <h1>About Tuulai</h1>
        </header>

        <p class="lead">
          Tuulai (<span lang="mn">туулай</span>, "rabbit") is a free website for learning Mongolian
          grammar step by step, from level M1 to M6.
        </p>

        <section>
          <h2>Inspiration</h2>
          <p>
            The idea and the layout of Tuulai – grammar lists by level and a summary card at the top
            of every grammar point – were inspired by{' '}
            <a href="https://jlptsensei.com/" rel="noopener">
              JLPT Sensei
            </a>{' '}
            – a website for learning Japanese. Tuulai is an independent project and is not
            affiliated with JLPT Sensei.
          </p>
        </section>

        <section>
          <h2>Sources</h2>
          <p>The grammar explanations on this site are based on:</p>
          <ul>
            <li>
              Rita Kullmann, D. Tserenpil. <cite>Mongolian Grammar</cite>.
            </li>
          </ul>
          <p>
            The explanations and example sentences on Tuulai are written in our own words and
            simplified for each level.
          </p>
        </section>
      </>
    )}
  </article>
</BaseLayout>

<style>
  .about {
    max-width: 42rem;
    margin: clamp(2rem, 6vw, 4rem) auto;
    line-height: 1.7;
  }

  header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 800;
    color: var(--flag-blue);
  }

  .lead {
    font-size: 1.15rem;
    color: var(--color-muted);
  }

  h2 {
    display: inline-block;
    margin: 1.5rem 0 0.25rem;
    padding-bottom: 0.2rem;
    border-bottom: 3px solid var(--flag-red);
    font-size: 1.4rem;
  }
</style>
