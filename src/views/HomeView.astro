---
// Home page: minimal hero with placeholder copy and shortcuts to each level.
import BaseLayout from '../layouts/BaseLayout.astro';
import LogoMark from '../components/LogoMark.astro';
import { LEVELS } from '../lib/levels';
import { grammarListUrl } from '../lib/grammar';
import type { Locale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout locale={locale}>
  <section class="hero">
    <LogoMark size={96} />
    <h1>{t('home.title')}</h1>
    <p class="lead">{t('home.lead')}</p>
    <ul class="levels" aria-label={t('nav.levels')}>
      {LEVELS.map((level) => (
        <li>
          <a href={grammarListUrl(level, locale)}>{level}</a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding-block: clamp(3rem, 12vw, 6rem);
    text-align: center;
  }

  h1 {
    margin: 0.5rem 0 0;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--flag-blue);
  }

  .lead {
    margin: 0;
    font-size: 1.15rem;
    color: var(--color-muted);
  }

  .levels {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .levels a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 3.5rem;
    min-height: 2.75rem;
    border: 2px solid var(--flag-blue);
    border-radius: 999px;
    color: var(--flag-blue);
    font-weight: 700;
    text-decoration: none;
  }

  .levels a:hover {
    background: var(--flag-blue);
    color: #fff;
  }

  /* Phones: an even 3 × 2 grid instead of a ragged 5 + 1 wrap. */
  @media (max-width: 640px) {
    .levels {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      width: 100%;
      max-width: 18rem;
    }
  }
</style>
