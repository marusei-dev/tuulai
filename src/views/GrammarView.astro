---
// One grammar point: summary card, explanation in the reader's language and examples.
import { marked } from 'marked';
import BaseLayout from '../layouts/BaseLayout.astro';
import GrammarCard from '../components/GrammarCard.astro';
import {
  getOtherLevels,
  grammarListUrl,
  grammarUrl,
  highlightParts,
  type GrammarEntry,
} from '../lib/grammar';
import type { Locale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';
import '../styles/grammar-article.css';

interface Props {
  entry: GrammarEntry;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const t = useTranslations(locale);
const { title, subtitle, level, examples, explanation } = entry.data;
const relatedEntries = await getOtherLevels(entry);
// Fall back to the English explanation until a translation exists. The Markdown is
// written by site admins only, and the Content-Security-Policy blocks inline scripts.
const localized = explanation[locale];
const isFallback = !localized;
const explanationHtml = await marked.parse(localized ?? explanation.en);
---

<BaseLayout title={subtitle ? `${title} · ${subtitle}` : title} locale={locale}>
  <GrammarCard entry={entry} locale={locale} />

  <article class="grammar-article">
    {isFallback && <p class="notice">{t('grammar.missingExplanation')}</p>}
    <Fragment set:html={explanationHtml} />

    {examples.length > 0 && (
      <section>
        <h2>{t('grammar.examples')}</h2>
        <ol class="examples">
          {examples.map((example) => (
            <li>
              <p lang="mn" class="mn">
                {highlightParts(example.mn, title).map((part) =>
                  part.hit ? <mark>{part.text}</mark> : part.text,
                )}
              </p>
              <p>{example[locale]}</p>
            </li>
          ))}
        </ol>
      </section>
    )}

    {relatedEntries.length > 0 && (
      <section>
        <h2>{t('grammar.otherLevels')}</h2>
        <ul>
          {relatedEntries.map((other) => (
            <li>
              <a href={grammarUrl(other, locale)}>
                {other.data.level} · {other.data.title}
              </a>{' '}
              — {other.data.meaning[locale]}
            </li>
          ))}
        </ul>
      </section>
    )}

    <p class="back">
      ← <a href={grammarListUrl(level, locale)}>{t('list.title', { level })}</a>
    </p>
  </article>
</BaseLayout>

<style>
  .notice {
    padding: 0.75rem 1rem;
    background: var(--color-surface);
    border-radius: 8px;
    color: var(--color-muted);
  }

  .back {
    margin-top: 2.5rem;
  }
</style>
