---
// One grammar point: summary card, explanation in the reader's language and examples.
import { getEntries, getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import GrammarCard from '../components/GrammarCard.astro';
import { grammarListUrl, grammarUrl, highlightParts, type GrammarEntry } from '../lib/grammar';
import { DEFAULT_LOCALE, type Locale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';

interface Props {
  entry: GrammarEntry;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const t = useTranslations(locale);
const { title, subtitle, level, examples, related } = entry.data;
const relatedEntries = (await getEntries(related)).filter((other) => !other.data.draft);
// Fall back to the English explanation until a translation exists.
const explanation =
  (await getEntry('explanations', `${locale}/${entry.id}`)) ??
  (await getEntry('explanations', `${DEFAULT_LOCALE}/${entry.id}`));
const isFallback = explanation !== undefined && !explanation.id.startsWith(`${locale}/`);
const { Content } = explanation ? await render(explanation) : { Content: null };
---

<BaseLayout title={subtitle ? `${title} · ${subtitle}` : title} locale={locale}>
  <GrammarCard entry={entry} locale={locale} />

  <article class="prose">
    {isFallback && <p class="notice">{t('grammar.missingExplanation')}</p>}
    {Content && <Content />}

    {examples.length > 0 && (
      <section>
        <h2>{t('grammar.examples')}</h2>
        <ol class="examples">
          {examples.map((example) => (
            <li>
              <p lang="mn" class="mn">
                {highlightParts(example.mn, title).map((part) =>
                  part.hit ? <mark>{part.text}</mark> : part.text,
                )}
              </p>
              <p>{example[locale]}</p>
            </li>
          ))}
        </ol>
      </section>
    )}

    {relatedEntries.length > 0 && (
      <section>
        <h2>{t('grammar.otherLevels')}</h2>
        <ul>
          {relatedEntries.map((other) => (
            <li>
              <a href={grammarUrl(other, locale)}>
                {other.data.level} · {other.data.title}
              </a>{' '}
              — {other.data.meaning[locale]}
            </li>
          ))}
        </ul>
      </section>
    )}

    <p class="back">
      ← <a href={grammarListUrl(level, locale)}>{t('list.title', { level })}</a>
    </p>
  </article>
</BaseLayout>

<style>
  .prose {
    margin-bottom: 3rem;
    line-height: 1.7;
  }

  .prose :global(h2) {
    display: inline-block;
    margin: 1.5rem 0 0.5rem;
    padding-bottom: 0.2rem;
    border-bottom: 3px solid var(--flag-red);
    font-size: 1.5rem;
  }

  .prose :global(table) {
    border-collapse: collapse;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--color-border);
    text-align: left;
  }

  .examples {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-left: 1.5rem;
  }

  .examples p {
    margin: 0;
  }

  .mn {
    font-size: 1.15rem;
    font-weight: 700;
  }

  mark {
    background: none;
    color: var(--flag-red);
    font-weight: 900;
  }

  .notice {
    padding: 0.75rem 1rem;
    background: var(--color-surface);
    border-radius: 8px;
    color: var(--color-muted);
  }

  .back {
    margin-top: 2.5rem;
  }
</style>
