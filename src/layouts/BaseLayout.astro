---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { LOCALES, DEFAULT_LOCALE, localePath, splitLocale, type Locale } from '../i18n/locales';
// Fonts are bundled and served from our own domain, so visitors make no requests to
// third-party font services. Only the Mongolian-script subset of Noto is needed.
import '@fontsource-variable/nunito';
import '@fontsource/noto-sans-mongolian/mongolian-400.css';
import '../styles/global.css';

interface Props {
  title?: string;
  locale: Locale;
}

const { title, locale } = Astro.props;
const pageTitle = title ? `${title} | Tuulai` : 'Tuulai';

// The same page in every language, for search engines.
const { path } = splitLocale(Astro.url.pathname);
const alternates = LOCALES.map((l) => ({
  hreflang: l,
  href: new URL(localePath(l, path), Astro.site).href,
}));
const defaultHref = new URL(localePath(DEFAULT_LOCALE, path), Astro.site).href;
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={defaultHref} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Header locale={locale} />
    <main class="container">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
